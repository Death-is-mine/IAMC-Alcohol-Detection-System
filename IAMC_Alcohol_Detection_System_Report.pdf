1 0 0 1 52.8 83.16 cm
%PreformattedPara
.062745 .164706 .262745 rg
BT 1 0 0 1 3 601.7 Tm /F3 6.7 Tf 7.8 TL (001 /*) Tj T* (002   IAMC - Alcohol Detection and Vehicle Interlock \(teaching prototype\)) Tj T* (003   Arduino Uno + MQ-3 analog output) Tj T* (004   Outputs: buzzer D8, active-low relay driver D9, status LEDs D5/D6) Tj T* (005 ) Tj T* (006   SAFETY: This is a classroom prototype, not a certified breathalyzer or) Tj T* (007   road-ready vehicle controller. Never connect a microcontroller pin directly) Tj T* (008   to a vehicle starter circuit. Use a properly rated isolated automotive) Tj T* (009   interface and fail-safe review before any real deployment.) Tj T* (010 */) Tj T* (011 const byte SENSOR_PIN = A0;) Tj T* (012 const byte GREEN_LED = 5;) Tj T* (013 const byte RED_LED = 6;) Tj T* (014 const byte BUZZER_PIN = 8;) Tj T* (015 const byte RELAY_PIN = 9; // relay module input; active LOW means engine permit) Tj T* (016 const int TRIP_THRESHOLD = 500; // illustrative ADC threshold; calibrate on hardware) Tj T* (017 const unsigned long SAMPLE_INTERVAL_MS = 100;) Tj T* (018 const unsigned long WARMUP_MS = 20000;) Tj T* (019 ) Tj T* (020 unsigned long startedAt;) Tj T* (021 unsigned long lastSampleAt;) Tj T* (022 int filteredReading = 0;) Tj T* (023 bool filterInitialized = false;) Tj T* (024 ) Tj T* (025 void setSafeState\(\) {) Tj T* (026   digitalWrite\(RELAY_PIN, HIGH\); // de-energize active-low relay: inhibit start) Tj T* (027   digitalWrite\(GREEN_LED, LOW\);) Tj T* (028   digitalWrite\(RED_LED, HIGH\);) Tj T* (029   noTone\(BUZZER_PIN\);) Tj T* (030 }) Tj T* (031 ) Tj T* (032 void setup\(\) {) Tj T* (033   pinMode\(GREEN_LED, OUTPUT\);) Tj T* (034   pinMode\(RED_LED, OUTPUT\);) Tj T* (035   pinMode\(BUZZER_PIN, OUTPUT\);) Tj T* (036   pinMode\(RELAY_PIN, OUTPUT\);) Tj T* (037   setSafeState\(\);) Tj T* (038   Serial.begin\(9600\);) Tj T* (039   startedAt = millis\(\);) Tj T* (040   Serial.println\(F\("IAMC alcohol detector - sensor warm-up"\)\);) Tj T* (041 }) Tj T* (042 ) Tj T* (043 void loop\(\) {) Tj T* (044   const unsigned long now = millis\(\);) Tj T* (045   if \(now - lastSampleAt < SAMPLE_INTERVAL_MS\) return;) Tj T* (046   lastSampleAt = now;) Tj T* (047 ) Tj T* (048   const int raw = analogRead\(SENSOR_PIN\);) Tj T* (049   if \(!filterInitialized\) {) Tj T* (050     filteredReading = raw;) Tj T* (051     filterInitialized = true;) Tj T* (052   } else {) Tj T* (053     filteredReading = \(filteredReading * 3 + raw\) / 4; // light smoothing) Tj T* (054   }) Tj T* (055 ) Tj T* (056   Serial.print\(F\("raw="\)\);) Tj T* (057   Serial.print\(raw\);) Tj T* (058   Serial.print\(F\(" filtered="\)\);) Tj T* (059   Serial.println\(filteredReading\);) Tj T* (060 ) Tj T* (061   if \(now - startedAt < WARMUP_MS\) {) Tj T* (062     setSafeState\(\);) Tj T* (063     Serial.println\(F\("WARMUP: start inhibited"\)\);) Tj T* (064     return;) Tj T* (065   }) Tj T* (066 ) Tj T* (067   if \(filteredReading >= TRIP_THRESHOLD\) {) Tj T* (068     setSafeState\(\);) Tj T* (069     tone\(BUZZER_PIN, 2200\);) Tj T* (070     Serial.println\(F\("ALCOHOL ABOVE SET THRESHOLD: start inhibited"\)\);) Tj T* (071   } else {) Tj T* (072     digitalWrite\(RELAY_PIN, LOW\); // energize active-low relay module: permit start) Tj T* (073     digitalWrite\(GREEN_LED, HIGH\);) Tj T* (074     digitalWrite\(RED_LED, LOW\);) Tj T* (075     noTone\(BUZZER_PIN\);) Tj T* (076     Serial.println\(F\("BELOW SET THRESHOLD: start permitted"\)\);) Tj T* (077   }) Tj T* (078 }) Tj T* ET
Q
 

